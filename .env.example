# ---------------------------------------------------------------------------
# StudyForge configuration
#
# Copy to `.env` and edit. Every value below has a safe default, so StudyForge
# runs with no .env file at all. Nothing here is required to use the app.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# SQLAlchemy URL. Defaults to a SQLite file under DATA_DIR.
# Postgres would work too (`postgresql+psycopg://...`) but is not tested in V1.
# DATABASE_URL=sqlite+pysqlite:///./data/studyforge.db

# Where uploaded documents and the SQLite database live. Stays on your machine.
# DATA_DIR=./data

# Signs the session cookie used for one-shot flash messages. Generate your own
# for any non-local deployment: `python -c "import secrets;print(secrets.token_urlsafe(32))"`
# SECRET_KEY=dev-insecure-change-me

# "development" enables the debug toolbar-ish error detail. Use "production" when hosting.
# ENVIRONMENT=development

# --- Uploads ----------------------------------------------------------------

# Hard cap on a single uploaded file, in megabytes.
# MAX_UPLOAD_MB=20

# --- Logging ----------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
# "json" for machine-readable structured logs, "console" for human-readable.
# LOG_FORMAT=console

# --- AI (entirely optional) -------------------------------------------------
#
# StudyForge is fully functional with AI_PROVIDER=none, which is the default.
# Concept extraction, flashcard generation, quiz generation and the entire
# spaced-repetition engine are deterministic and run locally without any model.
#
# none    - no AI at all. Everything deterministic. No data leaves your machine.
# ollama  - local models via Ollama. No API cost, no data leaves your machine.
#
# AI_PROVIDER=none

# Model name passed to the provider. For Ollama, must already be pulled locally
# (e.g. `ollama pull llama3.2`). StudyForge never downloads models for you.
# AI_MODEL=llama3.2

# AI_TIMEOUT_SECONDS=60

# --- Ollama -----------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
